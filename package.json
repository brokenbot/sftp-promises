{
  "name": "sftp-promises",
  "version": "2.0.0",
  "description": "SFTP Promise wrapper for ssh2 SFTP commands",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "mocha --require ts-node/register --exit",
    "coverage": "nyc _mocha --require ts-node/register -- --exit -R spec",
    "report-coverage": "nyc report --reporter=lcov",
    "check-coverage": "nyc check-coverage --statements 85 --branches 70 --functions 90 --lines 90",
    "docs": "typedoc --out docs src/index.ts",
    "eslint": "eslint --ext .ts,.js src/**/*",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokenbot/sftp-promises.git"
  },
  "keywords": [
    "sftp",
    "promises",
    "ssh2",
    "ssh"
  ],
  "author": "Dave Sanderson",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/brokenbot/sftp-promises/issues"
  },
  "homepage": "https://github.com/brokenbot/sftp-promises#readme",
  "dependencies": {
    "ssh2": "^1.4.0",
    "ssh2-streams": "^0.4.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.9",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.19",
    "@types/ssh2": "^1.11.22",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@eslint/js": "^9.21.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "coveralls": "^3.1.1",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "mocha": "^11.1.0",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.12",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.16.0"
  }
}
