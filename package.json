{
  "name": "sftp-promises",
  "version": "1.8.0",
  "description": "SFTP Promise wrapper for ssh2 SFTP commands",
  "main": "index.js",
  "scripts": {
    "test": "mocha --exit",
    "coverage": "nyc --reporter=lcov --reporter=text mocha --exit",
    "check-coverage": "nyc check-coverage --statements 85 --branches 70 --functions 90 --lines 90",
    "report-coverage": "cat ./coverage/lcov.info | coveralls"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokenbot/sftp-promises.git"
  },
  "keywords": [
    "sftp",
    "promises",
    "ssh2",
    "ssh"
  ],
  "author": "Dave Sanderson",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/brokenbot/sftp-promises/issues"
  },
  "homepage": "https://github.com/brokenbot/sftp-promises#readme",
  "dependencies": {
    "ssh2": "^1.15.0",
    "ssh2-streams": "^0.4.2"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "coveralls": "^3.1.1",
    "nyc": "^15.1.0",
    "jsdoc": "^4.0.2",
    "mocha": "^10.2.0",
    "standard": "^17.0.0",
    "sinon": "^15.0.1",
    "proxyquire": "^2.1.3"
  },
  "overrides": {
    "form-data": "2.5.5",
    "qs": "6.14.1",
    "tough-cookie": "4.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
